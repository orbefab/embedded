* relay-flyback: generated by scripts/ngspice_refs.py from netlist.json. Do not edit.
.options temp=25 tnom=25 reltol=1e-5 abstol=1e-15 vntol=1e-12 gmin=1e-12
dd1 coil vcc dmod_d1
.model dmod_d1 d (is=9.4334e-08 n=2.0844 rs=0.0317)
rx_k1_s vcc x_k1 70.0
lk1 x_k1 x_k1_c 0.505
vx_k1_am x_k1_c coil dc 0
bx_k1_m x_k1_m 0 v = abs(i(vx_k1_am))
sx_k1_no vcc no x_k1_m 0 swno_k1
.model swno_k1 sw (vt=0.030357142857142857 vh=0.02321428571428571 ron=0.1 roff=100000000.0)
sx_k1_nc vcc nc x_k1_m 0 swnc_k1
.model swnc_k1 sw (vt=0.030357142857142857 vh=0.02321428571428571 ron=100000000.0 roff=0.1)
dled1 vled 0 dmod_led1
.model dmod_led1 d (is=6.711e-10 n=4.427 rs=2.115)
vx_q1_c coil x_q1_c dc 0
vx_q1_b b x_q1_b dc 0
qq1 x_q1_c x_q1_b 0 qmod_q1
.model qmod_q1 npn (is=8.095e-15 bf=173.2 br=0.2704 nf=1.0 nr=1.0 vaf=100.0 rb=5.707 rc=1.531 re=0.867 cje=8e-12 cjc=4e-12 mje=0 mjc=0)
rrb pin b 1000.0
rrl no vled 220.0
rrnc nc 0 1000.0
vv1 vcc 0 dc 5.0
vvpin pin 0 dc 0.0 pwl(0p 0.0 5000000000p 0.0 5000001000p 5.0 30000000000p 5.0 30000001000p 0.0)
* The engine's gmin on every node, beside the gmin ngspice puts across each junction.
rx_gmin_vcc vcc 0 1000000000000.0
rx_gmin_pin pin 0 1000000000000.0
rx_gmin_b b 0 1000000000000.0
rx_gmin_coil coil 0 1000000000000.0
rx_gmin_no no 0 1000000000000.0
rx_gmin_nc nc 0 1000000000000.0
rx_gmin_vled vled 0 1000000000000.0
* One source per corner. Its first point is the corner, a breakpoint from t = 0, and its second point is the stop.
vbp0 bp0 0 pwl(5000000000p 0 60000000000p 0)
vbp1 bp1 0 pwl(5000001000p 0 60000000000p 0)
vbp2 bp2 0 pwl(30000000000p 0 60000000000p 0)
vbp3 bp3 0 pwl(30000001000p 0 60000000000p 0)
.control
save v(vcc) v(pin) v(b) v(coil) v(no) v(nc) v(vled) i(vv1) i(vvpin) @dd1[id] i(vx_k1_am) @dled1[id] i(vx_q1_c) i(vx_q1_b) @rrb[i] @rrl[i] @rrnc[i]
tran 60000000p 60000000000p 0 1000000p
set filetype=ascii
write tran.raw
.endc
.end

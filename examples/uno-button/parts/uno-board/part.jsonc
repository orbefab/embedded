// The Uno R3. Frame: the board's underside on z = 0 and its top at z = 1.6, the outline's centre on
// the origin, the USB and power jacks at -X, the digital header along +Y. The layout is the one
// orbefab/models places its parts by.
// The wires are the copper of Arduino's UNO-TH_Rev3e board file, net by net. Values that cite the
// schematic are the engine's board example values by role, from
// engine/examples/atmega-board-button/netlist.json, or read off the same sheet. Passives are
// named by designator, since one resistor array serves several roles.
{
  "format": 1,
  "part": "uno-board",
  "version": "0.1.0",
  "title": "Uno R3",
  "summary": "ATmega328P board, 68.6 x 53.3 mm, with female headers on top. D13 drives the L LED. Powered from USB, with 3V3 from its own regulator. The real board buffers D13 through an op-amp the engine does not have, so here D13 feeds the L LED directly, and D13 as an input with its pull-up reads low.",
  "tags": ["board", "microcontroller", "avr", "atmega328p", "usb"],
  "license": "MIT OR Apache-2.0",
  "docs": {
    "Arduino UNO R3 A000066 datasheet": "https://docs.arduino.cc/resources/datasheets/A000066-datasheet.pdf",
    "Arduino UNO R3 A000066 full pinout": "https://docs.arduino.cc/resources/pinouts/A000066-full-pinout.pdf",
    "development board schematic, revision 3": "https://www.arduino.cc/en/uploads/Main/Arduino_Uno_Rev3-schematic.pdf",
    "Arduino UNO-TH_Rev3e board file": "https://docs.arduino.cc/hardware/uno-rev3/",
  },
  "real": { "maker": "Arduino", "number": "A000066", "datasheet": "Arduino UNO R3 A000066 datasheet" },
  "uses": {
    "ams1117-sot223": "0.1.0", "atmega16u2-qfn32": "0.1.0", "atmega328p-dip28": "0.1.0",
    "barrel-jack-dc21": "0.1.0", "capacitor-0603": "0.1.0", "capacitor-electrolytic-smd": "0.1.0",
    "crystal-hc49us": "0.1.0", "diode-cd1206": "0.1.0", "diode-m7-sma": "0.1.0",
    "dip-socket-28": "0.1.0", "inductor-0805": "0.1.0", "led-0805": "0.1.0", "lmv358-msop8": "0.1.0",
    "lp2985-sot23-5": "0.1.0", "pin-header-2x3": "0.1.0", "pmos-fdn340p-sot23": "0.1.0",
    "ptc-fuse-1812": "0.1.0", "resistor-0603": "0.1.0", "resistor-array-4x0603": "0.1.0",
    "resonator-cstce": "0.1.0", "socket-strip-1x10": "0.1.0", "socket-strip-1x6": "0.1.0",
    "socket-strip-1x8": "0.1.0", "tactile-switch-ts42": "0.1.0", "usb-b-socket": "0.1.0",
  },
  "params": {
    "firmware": {}, // the scene must set it, as `"firmware": "build/button.ino.hex"`
  },
  "ground": "usb.GND",
  "parts": {
    "usb": { "type": "usb-b-socket" }, // X2
    "jack": { "type": "barrel-jack-dc21" }, // X1
    "usb_fuse": { "type": "ptc-fuse-1812" }, // F1
    "usb_switch": { "type": "pmos-fdn340p-sot23" }, // T1
    "mcu_socket": { "type": "dip-socket-28" },
    "mcu": { "type": "atmega328p-dip28", "firmware": { "param": "firmware" } }, // ZU4, the Uno's firmware reaches the 328P
    "usb_serial": { "type": "atmega16u2-qfn32" }, // U3
    "op_amp": { "type": "lmv358-msop8" }, // U5
    "reg_3v3": { "type": "lp2985-sot23-5" }, // U2
    // U1 is an NCP1117ST50T3G, in the AMS1117's package and pinout.
    "regulator": { "type": "ams1117-sot223", "not_simulated": "It makes 5 V from VIN, which is not simulated." },
    "sw_reset": { "type": "tactile-switch-ts42" }, // RESET
    "resonator": { "type": "resonator-cstce" }, // Y2
    "crystal": { "type": "crystal-hc49us" }, // Y1, the 16U2's clock
    "iol": { "type": "socket-strip-1x8" }, // D0 to D7
    "ioh": { "type": "socket-strip-1x10" }, // D8 to D13, GND, AREF, SDA, SCL
    "power": { "type": "socket-strip-1x8" }, // NC, IOREF, RESET, 3V3, 5V, GND, GND, VIN
    "ad": { "type": "socket-strip-1x6" }, // A0 to A5
    "icsp": { "type": "pin-header-2x3" },
    "icsp1": { "type": "pin-header-2x3" }, // the 16U2's
    "led_l": { "type": "led-0805", "color": "yellow" },
    "led_on": { "type": "led-0805", "color": "green" },
    "led_tx": { "type": "led-0805", "color": "yellow", "not_simulated": "The 16U2 drives it, and its model covers only TXD1 and DTR." },
    "led_rx": { "type": "led-0805", "color": "yellow", "not_simulated": "The 16U2 drives it, and its model covers only TXD1 and DTR." },
    "rn1": {
      "type": "resistor-array-4x0603", "resistance_a": "10k", "resistance_b": "10k", "resistance_c": "10k", "resistance_d": "10k",
      "not_simulated": "A and B divide VIN for the comparator that switches off USB power, and C pulls up the 16U2's reset. None of that is simulated, and a part is simulated whole, so D, the RESET pull-up, is out too. The 328P's own pull-up holds RESET high.",
    },
    "rn2": {
      "type": "resistor-array-4x0603",
      "resistance_a": { "value": 1000, "unit": "ohm", "source": { "datasheet": { "doc": "development board schematic, revision 3", "at": "RN2A, 1K", "basis": "nominal" } } }, // L13 to the L LED
      "resistance_b": { "value": 1000, "unit": "ohm", "source": { "datasheet": { "doc": "development board schematic, revision 3", "at": "RN2B, 1K", "basis": "nominal" } } }, // 5V to the RX LED
      "resistance_c": { "value": 1000, "unit": "ohm", "source": { "datasheet": { "doc": "development board schematic, revision 3", "at": "RN2C, 1K", "basis": "nominal" } } }, // 5V to the TX LED
      "resistance_d": { "value": 1000, "unit": "ohm", "source": { "datasheet": { "doc": "development board schematic, revision 3", "at": "RN2D, 1K, USB boot En", "basis": "nominal" } } }, // DTR to GND
    },
    "rn3": {
      "type": "resistor-array-4x0603", "resistance_a": "22", "resistance_b": "22", "resistance_c": "22", "resistance_d": "22",
      "not_simulated": "It carries USB data, which is not modelled.",
    },
    "rn4": {
      "type": "resistor-array-4x0603",
      "resistance_a": { "value": 1000, "unit": "ohm", "source": { "datasheet": { "doc": "development board schematic, revision 3", "at": "RN4A, 1K", "basis": "nominal" } } }, // D1 to the 16U2's RXD1
      "resistance_b": { "value": 1000, "unit": "ohm", "source": { "datasheet": { "doc": "development board schematic, revision 3", "at": "RN4B, 1K", "basis": "nominal" } } }, // the 16U2's TXD1 to D0
      "resistance_c": { "value": 1000, "unit": "ohm", "source": { "datasheet": { "doc": "development board schematic, revision 3", "at": "RN4C, 1K", "basis": "nominal" } } }, // 5V to the ON LED, with D
      "resistance_d": { "value": 1000, "unit": "ohm", "source": { "datasheet": { "doc": "development board schematic, revision 3", "at": "RN4D, 1K", "basis": "nominal" } } },
    },
    "d1": { "type": "diode-m7-sma", "not_simulated": "It guards VIN from the barrel jack, which is not simulated." },
    "d2": { "type": "diode-cd1206" }, // clamps RESET to 5V
    "d3": { "type": "diode-cd1206", "not_simulated": "It clamps the 16U2's reset, which is not simulated." },
    // L1 is a BLM21 ferrite bead, with no inductance to cite. Its values are placeholders.
    "l1": { "type": "inductor-0805", "inductance": "1u", "series_resistance": "0.1", "not_simulated": "It joins USB ground to the shield, which carries nothing the engine models." },
    "l2": {
      "type": "inductor-0805",
      "inductance": { "value": 1e-05, "unit": "H", "source": { "datasheet": { "doc": "Arduino UNO-TH_Rev3e board file", "at": "L2, 10uH", "basis": "nominal" } } },
      "series_resistance": { "value": 0.5, "unit": "ohm", "source": { "closed_form": { "note": "A guess. The board file gives L2 only as 10uH, with no part number." } } },
    },
    "c1": { "type": "capacitor-0603", "capacitance": "100n", "not_simulated": "A rail capacitor. The engine's board example leaves rail capacitors out." },
    "c2": { "type": "capacitor-0603", "capacitance": "100n", "not_simulated": "A rail capacitor. The engine's board example leaves rail capacitors out." },
    "c3": { "type": "capacitor-0603", "capacitance": { "value": 1e-06, "unit": "F", "source": { "datasheet": { "doc": "development board schematic, revision 3", "at": "C3, 1 uF", "basis": "nominal" } } } },
    "c4": {
      "type": "capacitor-0603",
      "capacitance": { "value": 1e-07, "unit": "F", "source": { "datasheet": { "doc": "development board schematic, revision 3", "at": "C4, 100 nF", "basis": "nominal" } } },
      "initial": { "value": 0.0, "unit": "V", "source": { "closed_form": { "note": "held at 0 V, so the operating point has a DC path on this net" } } },
    },
    "c5": { "type": "capacitor-0603", "capacitance": { "value": 1e-07, "unit": "F", "source": { "datasheet": { "doc": "development board schematic, revision 3", "at": "C5, 100 nF", "basis": "nominal" } } } },
    "c6": { "type": "capacitor-0603", "capacitance": "100n", "not_simulated": "A rail capacitor. The engine's board example leaves rail capacitors out." },
    "c7": { "type": "capacitor-0603", "capacitance": "100n", "not_simulated": "A rail capacitor. The engine's board example leaves rail capacitors out." },
    "c8": { "type": "capacitor-0603", "capacitance": "1u", "not_simulated": "It sits on the 16U2's UCAP, which is not simulated." },
    "c9": { "type": "capacitor-0603", "capacitance": "22p", "not_simulated": "It loads the 16U2's crystal, which is not simulated." },
    "c10": { "type": "capacitor-0603", "capacitance": "100n", "not_simulated": "A rail capacitor. The engine's board example leaves rail capacitors out." },
    "c11": { "type": "capacitor-0603", "capacitance": "22p", "not_simulated": "It loads the 16U2's crystal, which is not simulated." },
    "pc1": { "type": "capacitor-electrolytic-smd", "capacitance": "47u", "not_simulated": "It sits on VIN, which is not simulated." },
    "pc2": { "type": "capacitor-electrolytic-smd", "capacitance": "47u", "not_simulated": "A rail capacitor. The engine's board example leaves rail capacitors out." },
    // Z1 and Z2 are CG0603MLC-05E ESD suppressors in an 0603 chip, with no capacitance to cite. Their values are placeholders.
    "z1": { "type": "capacitor-0603", "capacitance": "100p", "not_simulated": "An ESD suppressor on USB data, which is not modelled." },
    "z2": { "type": "capacitor-0603", "capacitance": "100p", "not_simulated": "An ESD suppressor on USB data, which is not modelled." },
    "r1": { "type": "resistor-0603", "resistance": "1M", "not_simulated": "It biases the 16U2's crystal, which is not simulated." },
    "r2": { "type": "resistor-0603", "resistance": "1M", "not_simulated": "It sits across the resonator, and the engine's chips take their clock as a value." },
  },
  // Every wire but the socket's contacts is copper on the board, so each is a trace, which the viewer does not draw.
  "wires": [
    // USB 5 V through F1 and T1 onto the 5V rail
    ["usb_fuse.2", "usb.VBUS", { "kind": "trace" }],
    ["usb_serial.UVCC", "usb_switch.D", { "kind": "trace" }],
    ["usb_serial.UVCC", "usb_fuse.1", { "kind": "trace" }],
    ["usb_switch.S", "mcu.VCC", { "kind": "trace" }],
    ["usb_switch.S", "usb_serial.AVCC", { "kind": "trace" }],
    ["usb_switch.S", "usb_serial.VCC", { "kind": "trace" }],
    ["usb_switch.S", "reg_3v3.IN", { "kind": "trace" }],
    ["usb_switch.S", "reg_3v3.ON_OFF", { "kind": "trace" }],
    ["usb_switch.S", "regulator.OUT", { "kind": "trace" }],
    ["usb_switch.S", "op_amp.VCC", { "kind": "trace" }],
    ["usb_switch.S", "c1.b", { "kind": "trace" }],
    ["usb_switch.S", "c2.b", { "kind": "trace" }],
    ["usb_switch.S", "c6.b", { "kind": "trace" }],
    ["usb_switch.S", "c7.a", { "kind": "trace" }],
    ["usb_switch.S", "d2.cathode", { "kind": "trace" }],
    ["usb_switch.S", "d3.cathode", { "kind": "trace" }],
    ["usb_switch.S", "icsp.2", { "kind": "trace" }],
    ["usb_switch.S", "icsp1.2", { "kind": "trace" }],
    ["usb_switch.S", "l2.1", { "kind": "trace" }],
    ["usb_switch.S", "pc2.pos", { "kind": "trace" }],
    ["usb_switch.S", "power.2", { "kind": "trace" }],
    ["usb_switch.S", "power.5", { "kind": "trace" }],
    ["usb_switch.S", "rn1.3", { "kind": "trace" }],
    ["usb_switch.S", "rn1.5", { "kind": "trace" }],
    ["usb_switch.S", "rn2.2", { "kind": "trace" }],
    ["usb_switch.S", "rn2.3", { "kind": "trace" }],
    ["usb_switch.S", "rn4.3", { "kind": "trace" }],
    ["usb_switch.S", "rn4.4", { "kind": "trace" }],
    // GND, and USB ground. The last wire is the GROUND solder jumper between them. The board file
    // draws it as two pads, but a board powered from USB needs it closed.
    ["mcu.GND", "usb_serial.GND", { "kind": "trace" }],
    ["mcu.GND", "reg_3v3.GND", { "kind": "trace" }],
    ["mcu.GND", "regulator.GND", { "kind": "trace" }],
    ["mcu.GND", "op_amp.GND", { "kind": "trace" }],
    ["mcu.GND", "c1.a", { "kind": "trace" }],
    ["mcu.GND", "c10.a", { "kind": "trace" }],
    ["mcu.GND", "c11.b", { "kind": "trace" }],
    ["mcu.GND", "c2.a", { "kind": "trace" }],
    ["mcu.GND", "c3.a", { "kind": "trace" }],
    ["mcu.GND", "c4.a", { "kind": "trace" }],
    ["mcu.GND", "c6.a", { "kind": "trace" }],
    ["mcu.GND", "c7.b", { "kind": "trace" }],
    ["mcu.GND", "c9.b", { "kind": "trace" }],
    ["mcu.GND", "icsp.6", { "kind": "trace" }],
    ["mcu.GND", "icsp1.6", { "kind": "trace" }],
    ["mcu.GND", "ioh.7", { "kind": "trace" }],
    ["mcu.GND", "jack.sleeve", { "kind": "trace" }],
    ["mcu.GND", "jack.switch", { "kind": "trace" }],
    ["mcu.GND", "led_l.cathode", { "kind": "trace" }],
    ["mcu.GND", "led_on.cathode", { "kind": "trace" }],
    ["mcu.GND", "pc1.neg", { "kind": "trace" }],
    ["mcu.GND", "pc2.neg", { "kind": "trace" }],
    ["mcu.GND", "power.6", { "kind": "trace" }],
    ["mcu.GND", "power.7", { "kind": "trace" }],
    ["mcu.GND", "resonator.GND", { "kind": "trace" }],
    ["mcu.GND", "rn1.7", { "kind": "trace" }],
    ["mcu.GND", "rn2.5", { "kind": "trace" }],
    ["mcu.GND", "sw_reset.a", { "kind": "trace" }],
    ["usb_serial.UGND", "usb.GND", { "kind": "trace" }],
    ["usb_serial.UGND", "c8.b", { "kind": "trace" }],
    ["usb_serial.UGND", "l1.1", { "kind": "trace" }],
    ["usb.GND", "mcu.GND", { "kind": "trace" }],
    // 3V3
    ["reg_3v3.OUT", "op_amp.IN1_N", { "kind": "trace" }],
    ["reg_3v3.OUT", "c3.b", { "kind": "trace" }],
    ["reg_3v3.OUT", "power.4", { "kind": "trace" }],
    // VIN from the barrel jack, and the comparator that would switch USB off
    ["regulator.IN", "d1.cathode", { "kind": "trace" }],
    ["regulator.IN", "pc1.pos", { "kind": "trace" }],
    ["regulator.IN", "power.8", { "kind": "trace" }],
    ["regulator.IN", "rn1.8", { "kind": "trace" }],
    ["d1.anode", "jack.center", { "kind": "trace" }],
    ["op_amp.IN1_P", "rn1.1", { "kind": "trace" }],
    ["op_amp.IN1_P", "rn1.2", { "kind": "trace" }],
    ["usb_switch.G", "op_amp.OUT1", { "kind": "trace" }],
    // RESET, with the auto-reset from DTR
    ["mcu.PC6", "c5.b", { "kind": "trace" }],
    ["mcu.PC6", "d2.anode", { "kind": "trace" }],
    ["mcu.PC6", "icsp.5", { "kind": "trace" }],
    ["mcu.PC6", "power.3", { "kind": "trace" }],
    ["mcu.PC6", "rn1.4", { "kind": "trace" }],
    ["mcu.PC6", "sw_reset.b", { "kind": "trace" }],
    ["usb_serial.PD7", "c5.a", { "kind": "trace" }],
    ["usb_serial.PD7", "rn2.4", { "kind": "trace" }],
    // The 328P's clock, AREF and AVCC
    ["mcu.PB6", "r2.a", { "kind": "trace" }],
    ["mcu.PB6", "resonator.OUT", { "kind": "trace" }],
    ["mcu.PB7", "r2.b", { "kind": "trace" }],
    ["mcu.PB7", "resonator.IN", { "kind": "trace" }],
    ["mcu.AREF", "c4.b", { "kind": "trace" }],
    ["mcu.AREF", "ioh.8", { "kind": "trace" }],
    ["mcu.AVCC", "c10.b", { "kind": "trace" }],
    ["mcu.AVCC", "l2.2", { "kind": "trace" }],
    // Serial between the 16U2 and D0, D1
    ["usb_serial.PD3", "rn4.7", { "kind": "trace" }],
    ["usb_serial.PD2", "rn4.8", { "kind": "trace" }],
    // D13 and the L LED. U5B follows D13 onto L13, and RN2A feeds the LED from there.
    ["mcu.PB5", "op_amp.IN2_P", { "kind": "trace" }],
    ["mcu.PB5", "icsp.3", { "kind": "trace" }],
    ["mcu.PB5", "ioh.6", { "kind": "trace" }],
    ["op_amp.IN2_N", "op_amp.OUT2", { "kind": "trace" }],
    ["op_amp.IN2_N", "rn2.8", { "kind": "trace" }],
    // Stand-in: the engine has no op-amp, so a wire joins U5B's input to its output, as the
    // engine's board example drives the L LED from D13. D13 then carries the LED's current.
    ["op_amp.IN2_P", "op_amp.OUT2", { "kind": "trace" }],
    ["led_l.anode", "rn2.1", { "kind": "trace" }],
    // The ON LED
    ["led_on.anode", "rn4.5", { "kind": "trace" }],
    ["led_on.anode", "rn4.6", { "kind": "trace" }],
    // Header pins to the chip
    ["mcu.PD0", "iol.1", { "kind": "trace" }],
    ["mcu.PD0", "rn4.2", { "kind": "trace" }],
    ["mcu.PD1", "iol.2", { "kind": "trace" }],
    ["mcu.PD1", "rn4.1", { "kind": "trace" }],
    ["mcu.PD2", "iol.3", { "kind": "trace" }],
    ["mcu.PD3", "iol.4", { "kind": "trace" }],
    ["mcu.PD4", "iol.5", { "kind": "trace" }],
    ["mcu.PD5", "iol.6", { "kind": "trace" }],
    ["mcu.PD6", "iol.7", { "kind": "trace" }],
    ["mcu.PD7", "iol.8", { "kind": "trace" }],
    ["mcu.PB0", "ioh.1", { "kind": "trace" }],
    ["mcu.PB1", "ioh.2", { "kind": "trace" }],
    ["mcu.PB2", "ioh.3", { "kind": "trace" }],
    ["mcu.PB3", "icsp.4", { "kind": "trace" }],
    ["mcu.PB3", "ioh.4", { "kind": "trace" }],
    ["mcu.PB4", "icsp.1", { "kind": "trace" }],
    ["mcu.PB4", "ioh.5", { "kind": "trace" }],
    ["mcu.PC0", "ad.1", { "kind": "trace" }],
    ["mcu.PC1", "ad.2", { "kind": "trace" }],
    ["mcu.PC2", "ad.3", { "kind": "trace" }],
    ["mcu.PC3", "ad.4", { "kind": "trace" }],
    ["mcu.PC4", "ad.5", { "kind": "trace" }],
    ["mcu.PC4", "ioh.9", { "kind": "trace" }],
    ["mcu.PC5", "ad.6", { "kind": "trace" }],
    ["mcu.PC5", "ioh.10", { "kind": "trace" }],
    // The 16U2: its crystal, reset, ICSP, LEDs and USB data
    ["usb_serial.XTAL1", "c9.a", { "kind": "trace" }],
    ["usb_serial.XTAL1", "crystal.2", { "kind": "trace" }],
    ["usb_serial.XTAL1", "r1.a", { "kind": "trace" }],
    ["usb_serial.XTAL2", "c11.a", { "kind": "trace" }],
    ["usb_serial.XTAL2", "crystal.1", { "kind": "trace" }],
    ["usb_serial.XTAL2", "r1.b", { "kind": "trace" }],
    ["usb_serial.UCAP", "c8.a", { "kind": "trace" }],
    ["usb_serial.RESET", "d3.anode", { "kind": "trace" }],
    ["usb_serial.RESET", "icsp1.5", { "kind": "trace" }],
    ["usb_serial.RESET", "rn1.6", { "kind": "trace" }],
    ["usb_serial.PB3", "icsp1.1", { "kind": "trace" }],
    ["usb_serial.PB2", "icsp1.4", { "kind": "trace" }],
    ["usb_serial.PB1", "icsp1.3", { "kind": "trace" }],
    ["led_rx.anode", "rn2.7", { "kind": "trace" }],
    ["led_tx.anode", "rn2.6", { "kind": "trace" }],
    ["usb_serial.PD4", "led_rx.cathode", { "kind": "trace" }],
    ["usb_serial.PD5", "led_tx.cathode", { "kind": "trace" }],
    ["usb_serial.DP", "rn3.4", { "kind": "trace" }],
    ["usb_serial.DM", "rn3.1", { "kind": "trace" }],
    ["usb.DP", "rn3.5", { "kind": "trace" }],
    ["usb.DP", "z1.a", { "kind": "trace" }],
    ["usb.DM", "rn3.8", { "kind": "trace" }],
    ["usb.DM", "z2.a", { "kind": "trace" }],
    ["usb.SHIELD", "l1.2", { "kind": "trace" }],
    ["usb.SHIELD", "z1.b", { "kind": "trace" }],

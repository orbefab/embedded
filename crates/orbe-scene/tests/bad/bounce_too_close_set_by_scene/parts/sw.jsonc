{
  "format": 1,
  "pins": { "a": [1], "b": [2] },
  "params": {
    "bounce": { "unit": "s", "default": null, "sets": "/bounce/window" },
    "max_bounces": { "unit": "1", "default": 2, "sets": "/bounce/max_bounces" },
  },
  "model": {
    "kind": "switch",
    "on_resistance": { "value": 0.1, "unit": "ohm", "source": "user" },
    "off_resistance": { "value": 1e8, "unit": "ohm", "source": "user" },
    "initial": "open",
    "events": [{ "t_ps": 1000000000, "state": "closed" }, { "t_ps": 3000000000, "state": "open" }],
    "bounce": null,
  },
}

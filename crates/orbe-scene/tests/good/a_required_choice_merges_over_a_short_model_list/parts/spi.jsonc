  "format": 1,
  "pins": { "vcc": [1], "gnd": [2], "cs": [3], "sclk": [4], "d0": [5], "d1": [6], "d2": [7], "d3": [8] },
  "params": { "shell": { "default": "keep", "choices": { "keep": { "sets": { "/events/0/t_ps": 10000000 } }, "short": { "sets": { "/events": [{ "t_ps": 10000000, "lanes": 1, "bytes": [85], "cs": "released", "phases": [{ "bits": 8, "lanes": 1, "value": 1 }] }] } } } }, "fill": { "required": true, "choices": { "long": { "sets": { "/events/0": { "bytes": [1, 2, 3] } } } } }, "n": { "default": "nine", "choices": { "nine": { "sets": { "/events/0/bytes/2": 9 } } } } },

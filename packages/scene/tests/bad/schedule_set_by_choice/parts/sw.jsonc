{
  "format": 1,
  "pins": { "a": [1], "b": [2] },
  "params": { "press": { "default": "late", "choices": { "late": { "sets": { "/events/0/t_ps": 1000000000 } }, "now": { "sets": { "/events/0/t_ps": 0 } } } } },
  "model": {
    "kind": "switch",
    "on_resistance": { "value": 0.1, "unit": "ohm", "source": "user" },
    "off_resistance": { "value": 1e8, "unit": "ohm", "source": "user" },
    "initial": "open",
    "events": [{ "t_ps": 1000000000, "state": "closed" }],
    "bounce": null,
  },
}

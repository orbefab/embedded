// Button and LED on a Nano. D2 reads the button, D13 drives the LED.
{
  "format": 1,
  "parts": {
    "nano_board_with_a_name_long_enough_to_pass_the_limit": { "type": "nano-board", "firmware": "build/button.ino.hex" },
    "btn1": { "type": "tactile-switch-6mm" },
    "r2": { "type": "resistor-axial", "resistance": "10k" }, // pull-down, so D2 reads low while open
    "r1": { "type": "resistor-axial", "resistance": "220" },
    "led1": { "type": "led-5mm", "color": "red" },
  },
  "wires": [
    ["nano_board_with_a_name_long_enough_to_pass_the_limit.D2", "btn1.a"],
    ["btn1.b", "nano_board_with_a_name_long_enough_to_pass_the_limit.5V"],
    ["nano_board_with_a_name_long_enough_to_pass_the_limit.D2", "r2.a"],
    ["r2.b", "nano_board_with_a_name_long_enough_to_pass_the_limit.GND"],
    ["nano_board_with_a_name_long_enough_to_pass_the_limit.D13", "r1.a"],
    ["r1.b", "led1.anode"],
    ["led1.cathode", "nano_board_with_a_name_long_enough_to_pass_the_limit.GND"],
  ],
}

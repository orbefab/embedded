{
  "format": 1,
  "parts": {
    "nano": { "type": "nano-board", "firmware": "build/button.ino.hex" },
    "btn1": { "type": "tactile-switch-6mm" },
    "pot": { "type": "potentiometer-wh148", "resistance": "10k", "position": 0 },
    "r2": { "type": "resistor-axial", "resistance": "10k" },
    "r1": { "type": "resistor-axial", "resistance": "220" },
    "led1": { "type": "led-5mm" },
  },
  "wires": [
    ["nano.D2", "btn1.a"],
    ["btn1.b", "nano.5V"],
    ["nano.D2", "r2.a"],
    ["r2.b", "nano.GND"],
    ["nano.D13", "r1.a"],
    ["r1.b", "led1.anode"],
    ["led1.cathode", "nano.GND"],
    ["nano.5V", "pot.a"],
    ["pot.b", "nano.GND"],
    ["pot.wiper", "nano.A0"],
  ],
}

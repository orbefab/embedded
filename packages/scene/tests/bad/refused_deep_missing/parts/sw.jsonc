{
  "format": 1,
  "pins": { "a": [1], "b": [2] },
  "params": {
    "bounce": { "unit": "s", "default": null, "sets": "/bounce/window" },
    "edges": { "default": "two", "choices": { "two": { "sets": { "/bounce/max_bounces/value": 2, "/bounce/max_bounces/unit": "1", "/bounce/max_bounces/source": "user" } } } },
  },
  "model": {
    "kind": "switch",
    "on_resistance": { "value": 0.1, "unit": "ohm", "source": "user" },
    "off_resistance": { "value": 1e8, "unit": "ohm", "source": "user" },
    "initial": "open",
    "events": [],
    "bounce": null,
  },
}

{
  "format": 1,
  "pins": { "a": [1], "b": [2] },
  "params": { "start": { "default": "up", "choices": { "up": { "sets": { "/initial": "open" } }, "down": { "sets": { "/initial": "closed" } } } } },
  "model": {
    "kind": "switch",
    "on_resistance": { "value": 0.1, "unit": "ohm", "source": "user" },
    "off_resistance": { "value": 1e8, "unit": "ohm", "source": "user" },
    "initial": "open",
    "events": [{ "t_ps": 1000000000, "state": "closed" }],
    "bounce": null,
  },
}

// The button project, and a light sensor: 10 kohm from 5V over an LDR to GND.
{
  "format": 1,
  "parts": {
    "nano": { "type": "nano-board", "firmware": "build/button.ino.hex" },
    "btn1": { "type": "tactile-switch-6mm" },
    "r2": { "type": "resistor-axial", "resistance": "10k" },
    "r1": { "type": "resistor-axial", "resistance": "220" },
    "led1": { "type": "led-5mm" },
    "rt": { "type": "resistor-axial", "resistance": "10k" },
    "ldr": { "type": "./ldr.jsonc" },
  },
  "wires": [
    ["nano.D2", "btn1.a"],
    ["btn1.b", "nano.5V"],
    ["nano.D2", "r2.a"],
    ["r2.b", "nano.GND"],
    ["nano.D13", "r1.a"],
    ["r1.b", "led1.anode"],
    ["led1.cathode", "nano.GND"],
    ["nano.5V", "rt.a"],
    ["rt.b", "ldr.a"],
    ["ldr.b", "nano.GND"],
  ],
  "world": {
    "temperature": 30,
    "light": { "initial": 300, "steps": [{ "at": "20ms", "to": 50 }] },
  },
}

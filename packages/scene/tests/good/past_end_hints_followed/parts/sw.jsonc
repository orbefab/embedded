{
  "format": 1,
  "pins": { "a": [1], "b": [2] },
  "params": { "when": { "default": "no", "choices": { "no": { "sets": { "/events/0/t_ps": 2000000000 } } } }, "release": { "default": "late", "choices": { "late": { "sets": { "/events/1/t_ps": 3000000000 } }, "later": { "sets": { "/events/1/t_ps": 4000000000 } } } } },
  "model": {
    "kind": "switch",
    "on_resistance": { "value": 0.1, "unit": "ohm", "source": "user" },
    "off_resistance": { "value": 1e8, "unit": "ohm", "source": "user" },
    "initial": "open",
    "events": [{ "t_ps": 1000000000, "state": "closed" }, { "t_ps": 2500000000, "state": "open" }],
    "bounce": null,
  },
}

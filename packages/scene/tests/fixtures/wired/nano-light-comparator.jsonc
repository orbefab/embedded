// An LDR divider and a trimmer divider feed an LM358. Dark lights an LED and drives D2 high.
{
  "format": 1,
  "parts": {
    "nano": { "type": "nano-board", "firmware": "build/light.ino.hex" },
    "u1": { "type": "lm358-dip8" },
    "ldr": { "type": "ldr-5mm" },
    "trim": { "type": "trimmer-3362p", "resistance": "10k", "position": "0.5" },
    "rbot": { "type": "resistor-axial", "resistance": "2.2k" },
    "rset": { "type": "resistor-axial", "resistance": "4.7k" },
    "rhys": { "type": "resistor-axial", "resistance": "68k" },
    "rled": { "type": "resistor-axial", "resistance": "220" },
    "led1": { "type": "led-5mm" },
  },
  "nets": { "GND": "nano.GND" },
  "world": { "light": 300 },
  "wires": [
    ["nano.5V", "ldr.a"],
    ["ldr.b", "rbot.a"],
    ["ldr.b", "u1.IN1_N"],
    ["rbot.b", "nano.GND"],
    ["nano.5V", "rset.b"],
    ["rset.a", "trim.a"],
    ["trim.b", "nano.GND"],
    ["trim.wiper", "u1.IN1_P"],
    ["trim.wiper", "rhys.b"],
    ["rhys.a", "u1.OUT1"],
    ["u1.OUT1", "rled.b"],
    ["rled.a", "led1.anode"],
    ["led1.cathode", "nano.GND"],
    ["u1.OUT1", "nano.D2"],
    ["u1.VCC", "nano.5V"],
    ["u1.GND", "nano.GND"],
    ["u1.IN2_P", "nano.GND"],
    ["u1.IN2_N", "nano.GND"],
  ],
}

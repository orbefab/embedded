// A button on D2 lights an LED on D13 of an Uno, and the board's own L LED with it.
{
  "format": 1,
  "parts": {
    "uno": { "type": "uno-board", "firmware": "build/button.ino.hex" },
    "btn1": { "type": "tactile-switch-6mm" },
    "r2": { "type": "resistor-axial", "resistance": "10k" }, // pull-down, so D2 reads low while open
    "r1": { "type": "resistor-axial", "resistance": "220" },
    "led1": { "type": "led-5mm", "color": "red" },
  },
  "nets": { "GND": "uno.GND" },
  "wires": [
    ["uno.D2", "btn1.a"],
    ["btn1.b", "uno.5V"],
    ["uno.D2", "r2.a"],
    ["r2.b", "uno.GND"],
    ["uno.D13", "r1.a"],
    ["r1.b", "led1.anode"],
    ["led1.cathode", "uno.GND"],
  ],
}

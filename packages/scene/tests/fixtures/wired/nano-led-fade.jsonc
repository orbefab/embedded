// An LED on D9 of a Nano fades up and down by PWM.
{
  "format": 1,
  "parts": {
    "nano": { "type": "nano-board", "firmware": "build/fade.ino.hex" },
    "r1": { "type": "resistor-axial", "resistance": "220" },
    "led1": { "type": "led-5mm" },
  },
  "nets": { "GND": "nano.GND" },
  "wires": [
    ["nano.D9", "r1.a"],
    ["r1.b", "led1.anode"],
    ["led1.cathode", "nano.GND"],
  ],
}

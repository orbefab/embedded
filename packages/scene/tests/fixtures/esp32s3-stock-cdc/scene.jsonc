// GPIO4 lights an LED and prints over USB Serial/JTAG CDC. The app is the stock sketch
// packages/engine/tests/firmware/esp32s3/arduino/stock/cdc compiled with esp32:esp32 3.3.12
// and CDCOnBoot=cdc.
{
  "format": 1,
  "parts": {
    "board": {
      "type": "esp32s3-devkitc-1",
      "app": "app.bin",
      "partitions": "partitions.bin"
    },
    "r1": { "type": "resistor-axial", "resistance": "100" },
    "led1": { "type": "led-5mm" }
  },
  "wires": [
    ["board.GPIO4", "r1.a"],
    ["r1.b", "led1.anode"],
    ["led1.cathode", "board.GND"]
  ],
  "ground": "board.GND"
}

// GPIO4 runs 1 ms tone() notes back to back and spaced by delay(2).
// The app is the stock sketch packages/engine/tests/firmware/esp32s3/arduino/stock/tonefast.
{
  "format": 1,
  "parts": {
    "board": {
      "type": "esp32s3-devkitc-1",
      "app": "app.bin",
      "partitions": "partitions.bin"
    },
    "r1": { "type": "resistor-axial", "resistance": "220" },
    "led1": { "type": "led-5mm" }
  },
  "wires": [
    ["board.GPIO4", "r1.a"],
    ["r1.b", "led1.anode"],
    ["led1.cathode", "board.GND"]
  ],
  "ground": "board.GND"
}

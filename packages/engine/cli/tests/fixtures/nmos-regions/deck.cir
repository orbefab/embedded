* nmos-regions: generated by packages/engine/scripts/ngspice_refs.py from netlist.json. Do not edit.
.options temp=25 tnom=25 reltol=1e-9 abstol=1e-15 vntol=1e-12 gmin=1e-12
vx_m1_d d x_m1_d dc 0
vx_m1_g g x_m1_g dc 0
mm1 x_m1_d x_m1_g 0 0 mmod_m1 l=100u w=100u
.model mmod_m1 nmos (level=1 vto=1.08 kp=0.0468 lambda=0.0 is=0)
cm1_gs x_m1_g 0 5.5e-11
cm1_gd x_m1_g x_m1_d 5e-12
cm1_ds x_m1_d 0 2e-11
vvd d 0 dc -1.0 pwl(0p -1.0 100000000p -1.0 100001000p 0.3 200000000p 0.3 200001000p 4.0)
vvg g 0 dc 2.0
* The engine's gmin on every node, beside the gmin ngspice puts across each junction.
rx_gmin_d d 0 1000000000000.0
rx_gmin_g g 0 1000000000000.0
* One source per ramp corner makes it a breakpoint. ngspice skips a PWL corner it lands on an ulp early.
vbp0 bp0 0 pwl(100000000p 0 100000001p 0)
vbp1 bp1 0 pwl(100001000p 0 100001001p 0)
vbp2 bp2 0 pwl(200000000p 0 200000001p 0)
vbp3 bp3 0 pwl(200001000p 0 200001001p 0)
.control
save v(d) v(g) i(vvd) i(vvg) i(vx_m1_d) i(vx_m1_g)
tran 300000p 300000000p 0 300000p
set filetype=ascii
write tran.raw
.endc
.end

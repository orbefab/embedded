* v-pulse-rc: generated by packages/engine/scripts/ngspice_refs.py from netlist.json. Do not edit.
.options temp=25 tnom=25 reltol=1e-9 abstol=1e-15 vntol=1e-12 gmin=1e-12
cc1 vout 0 1e-07
rr1 vin vout 1000.0
vv1 vin 0 dc 0.0 pwl(0p 0.0 200000000p 0.0 200001000p 1.0 400000000p 1.0 400001000p 0.0 800000000p 0.0 800001000p 1.0 1000000000p 1.0 1000001000p 0.0 1400000000p 0.0)
* One source per ramp corner makes it a breakpoint. ngspice skips a PWL corner it lands on an ulp early.
vbp0 bp0 0 pwl(200000000p 0 200000001p 0)
vbp1 bp1 0 pwl(200001000p 0 200001001p 0)
vbp2 bp2 0 pwl(400000000p 0 400000001p 0)
vbp3 bp3 0 pwl(400001000p 0 400001001p 0)
vbp4 bp4 0 pwl(800000000p 0 800000001p 0)
vbp5 bp5 0 pwl(800001000p 0 800001001p 0)
vbp6 bp6 0 pwl(1000000000p 0 1000000001p 0)
vbp7 bp7 0 pwl(1000001000p 0 1000001001p 0)
vbp8 bp8 0 pwl(1400000000p 0 1400000001p 0)
.control
save v(vin) v(vout) i(vv1) @cc1[i] @rr1[i]
tran 1400000p 1400000000p 0 1400000p
set filetype=ascii
write tran.raw
.endc
.end

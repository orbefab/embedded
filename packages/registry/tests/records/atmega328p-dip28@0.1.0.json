  "notSimulated": [
    {
      "what": "output saturation",
      "why": "Each output stage is linear, 25 ohm from its rail, read at 20 mA. A real driver saturates far past that, so a pin shorted to the other rail reads 200 mA at 5 V, about twice a real pin's current. `rating.current` reads the model's current."
    },
    {
      "what": "clamp diodes",
      "why": "No protection diode conducts, so a pin driven past VCC or below GND draws no clamp current. `rating.voltage` reports the pin."
    },
    {
      "what": "supply current",
      "why": "The core draws nothing from VCC. The current the ratings sum through VCC and GND is the pins' alone."
    }
  ],

  "version": "0.2.1",
  "title": "Capacitor, radial electrolytic",
  "summary": "Polarized aluminum electrolytic can, 6.3 mm across, with two leads on 2.5 mm. The longer lead is `pos`, and the stripe on the sleeve marks `neg`. Wire `pos` to the higher voltage. A reverse voltage past 1 V warns. Set its capacitance. It starts where the circuit's DC solution puts it, which on a pin that is still an input is not 0 V. Set `initial`, such as \"0\", to start it at that voltage.",
  "tags": ["capacitor", "electrolytic", "polarized", "passive", "bulk", "filter", "timing", "through-hole"],
  "license": "MIT OR Apache-2.0",
  "docs": {
    "Nichicon UVR": null,
    "Nichicon, General Descriptions of Aluminum Electrolytic Capacitors": "https://www.nichicon.co.jp/english/products/pdf/aluminum.pdf",
  },
  "real": { "generic": true, "maker": "Nichicon", "number": "UVR", "datasheet": "Nichicon UVR" },
  "pins": { "pos": [1], "neg": [2] },
  "params": {
    "capacitance": { "unit": "F", "required": true, "example": 1e-5, "min_exclusive": 0, "sets": "/capacitance" },
    "initial": { "unit": "V", "default": null, "sets": "/initial" },
  },
  "model": {
    "kind": "capacitor",
    "pins": { "a": "pos", "b": "neg" },
    "series_resistance": {
      "value": 2.65,
      "unit": "ohm",
      "source": {
        "datasheet": {
          "doc": "Nichicon UVR",
          "at": "Tangent of loss angle (tan δ) max 0.20 at 120 Hz, 20 °C, for a rated voltage of 16 V. This model is the 100 µF 16 V can. ESR = tan δ / (2 π f C) = 2.65 ohm. The sheet states tan δ, not a 100 kHz ESR. The value does not change when the capacitance param does.",
          "basis": "max"
        }
      }
    },
    "ratings": {
      "reverse_voltage": {
        "value": 1,
        "unit": "V",
        "source": {
          "datasheet": {
            "doc": "Nichicon, General Descriptions of Aluminum Electrolytic Capacitors",
            "at": "Section 2-3-2 Reverse Voltage: a cathode foil withstands about 1 V because of the natural oxide layer on its surface. A reverse voltage over that raises the internal pressure and opens the vent.",
            "basis": "absolute_max"
          }
        }
      }
    }
  },
  "not_simulated": [
    { "what": "voltage rating", "why": "A forward voltage past the can's working voltage never warns. The reverse rating is separate: pos more than 1 V below neg warns." },

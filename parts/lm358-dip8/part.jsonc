// One op_amp body per channel, both on the shared supply pins. The values are the typicals of
// TI SLOS068AB p10 section 5.7, the LM358 column, at VS 5 V and 25 °C unless a row says otherwise.
// The high swing and the output resistance are the line through figure 5-46.
{
  "format": 1, "part": "lm358-dip8", "version": "0.1.0", "title": "LM358 dual op-amp, DIP-8", "license": "MIT OR Apache-2.0",
  "docs": { "TI SLOS068AB": "https://www.ti.com/lit/ds/symlink/lm358.pdf" },
  "real": { "maker": "Texas Instruments", "number": "LM358P", "datasheet": "TI SLOS068AB" },
  "pins": { "OUT1": [1], "IN1_N": [2], "IN1_P": [3], "GND": [4], "IN2_P": [5], "IN2_N": [6], "OUT2": [7], "VCC": [8] },
  "model": {
    "a": {
      "kind": "op_amp",
      "gain_bandwidth": { "value": 700000.0, "unit": "Hz", "source": { "datasheet": { "doc": "TI SLOS068AB", "at": "p10 section 5.7, GBW typical, header VS 5 V", "basis": "typical" } } },
      "slew_rate": { "value": 300000.0, "unit": "V/s", "source": { "datasheet": { "doc": "TI SLOS068AB", "at": "p10 section 5.7, SR typical, G = +1", "basis": "typical" } } },
      "open_loop_gain": { "value": 100000.0, "unit": "1", "source": { "datasheet": { "doc": "TI SLOS068AB", "at": "p10 section 5.7, AOL 100 V/mV typical at VS 15 V, VO 1 V to 11 V, RL at least 2 kohm", "basis": "typical" } } },
      "input_bias_current": { "value": 2.0e-08, "unit": "A", "source": { "datasheet": { "doc": "TI SLOS068AB", "at": "p10 section 5.7, IB typical -20 nA into the pin at VO 1.4 V. The field is the current that leaves", "basis": "typical" } } },
      "swing_high": { "value": 1.2, "unit": "V", "source": { "closed_form": { "note": "p23 figure 5-46, section 5.12. The stroke center is 1.212 V below Vcc at 0.1 mA and 1.286 V below Vcc at 1 mA. The line through them falls 82.2 ohm and starts 1.204 V below Vcc, rounded to 1.20 V. The x-axis is printed Output Sink Current. The title is Output Sourcing Characteristics and the axis is the drop from Vcc, so the current is source current. The figure does not print a supply. Section 5.7's 5 V positive-rail row is a maximum of 1.5 V from V+ and has no typical" } } },
      "swing_low": { "value": 0.005, "unit": "V", "source": { "closed_form": { "note": "p10 section 5.7 VOL typical 5 mV from V- at VS 5 V, RL at most 10 kohm, returned to V-. One load, so the intercept is that typical. Figure 5-47's slope is not output_resistance" } } },
      "output_resistance": { "value": 80.0, "unit": "ohm", "source": { "closed_form": { "note": "the slope of the swing_high line, 74 mV over 0.9 mA, 82.2 ohm, rounded to 80. One resistance covers sourcing and sinking. Sinking into a load returned above V- is optimistic against p23 figure 5-47, whose 5 V curve plateaus near 0.7 V at a few hundred uA, so the model reads 24.8 mV into 10 kohm and 101 mV into 2 kohm, both returned to 2.5 V" } } },
      "short_circuit_current": { "value": 0.04, "unit": "A", "source": { "datasheet": { "doc": "TI SLOS068AB", "at": "p10 section 5.7, ISC +/-40 mA typical at VS 10 V, VO = VS / 2", "basis": "typical" } } },
      "supply_current": { "value": 0.00035, "unit": "A", "source": { "closed_form": { "note": "p10 section 5.7 IQ 350 uA typical per amplifier at VO 2.5 V and IO 0 A. The row is already one amplifier" } } },
      "pins": { "in_p": "IN1_P", "in_n": "IN1_N", "out": "OUT1", "vcc": "VCC", "gnd": "GND" },
    },

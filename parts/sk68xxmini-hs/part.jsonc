{
  "format": 3,
  "part": "sk68xxmini-hs",
  "version": "0.2.0",
  "title": "SK68XXMINI-HS addressable RGB LED",
  "summary": "One addressable RGB LED in a 3.7 x 3.5 x 1.95 mm package. Pin 1 is GND, pin 2 DIN, pin 3 VDD and pin 4 DOUT. It keeps the first 24 bits it reads and passes the rest to the next LED on DOUT, so a chain on one pin shows one colour per LED. Its reading `color` is the last colour it latched. The sheet's supply is 3.7 V to 5.5 V. The engine times the bits as a Worldsemi WS2812E, and this sheet's longest 0-bit high is 0.4 us, past that window. Adafruit NeoPixel (16 MHz AVR) drives this part within its windows.",
  "tags": ["led", "rgb", "addressable", "ws2812"],
  "license": "MIT OR Apache-2.0",
  "docs": { "SPC / SK68XX MINI-HS Rev. 04": null },
  "real": { "maker": "SPC", "number": "SK68XXMINI-HS", "datasheet": "SPC / SK68XX MINI-HS Rev. 04" },
  "pins": { "GND": [1], "DIN": [2], "VDD": [3], "DOUT": [4] },
  "model": {
    "kind": "ws2812",
    "leds": 1,
    "pins": { "VCC": "VDD", "GND": "GND", "DIN": "DIN", "DOUT": "DOUT" },
    "input_threshold": {
      "low": {
        "value": 0.3,
        "unit": "1",
        "source": {
          "datasheet": {
            "doc": "SPC / SK68XX MINI-HS Rev. 04",
            "at": "Section 10, VIL 0.3 VDD maximum, test condition VDD = 5.0 V",
            "basis": "max"
          }
        }
      },
      "high": {
        "value": 0.7,
        "unit": "1",
        "source": {
          "datasheet": {
            "doc": "SPC / SK68XX MINI-HS Rev. 04",
            "at": "Section 10, VIH 0.7 VDD minimum, test condition VDD = 5.0 V",
            "basis": "min"
          }
        }
      }
    },
    "dout": {
      "output": {
        "high_drop": { "value": 0.0, "unit": "V", "source": { "closed_form": { "note": "The sheet gives no DOUT output voltage. DOUT drives the next LED's DIN, which draws no current in the engine, so a high sits at VDD" } } },
        "high_resistance": { "value": 100.0, "unit": "ohm", "source": { "closed_form": { "note": "The sheet gives no DOUT drive strength. DIN draws no current, so the level DOUT sets does not depend on this value. 100 ohm keeps a DOUT shorted to GND at 50 mA at 5 V" } } },
        "low_drop": { "value": 0.0, "unit": "V", "source": { "closed_form": { "note": "The sheet gives no DOUT output voltage. DOUT drives the next LED's DIN, which draws no current in the engine, so a low sits at GND" } } },
        "low_resistance": { "value": 100.0, "unit": "ohm", "source": { "closed_form": { "note": "The sheet gives no DOUT drive strength. DIN draws no current, so the level DOUT sets does not depend on this value. 100 ohm keeps a DOUT shorted to VDD at 50 mA at 5 V" } } }
      },
      "delay": {
        "value": 500000,
        "unit": "ps",
        "source": {
          "datasheet": {
            "doc": "SPC / SK68XX MINI-HS Rev. 04",
            "at": "Section 11, DIN to DOUT transmission delay, 500 ns maximum",
            "basis": "max"
          }
        }
      }
    }
  },
  "readings": {
    "color": { "of": "rgb" }
  },
  "view": {
    "glow": [{ "node": "lens", "by": "color" }]
  },
  "not_simulated": [
    {
      "what": "data output",
      "why": "DOUT follows DIN 500 ns later, rise and fall alike, once this LED holds its 24 bits, and is low before that and until the next reset. Section 11 gives that delay as a maximum and no typical, and gives no output widths, so DOUT passes each high as long as it came. The sheet gives no DOUT drive strength either; the output stage is 100 ohm to each rail. Bits a Pulses record carried, such as an ESP32-S3 RMT train, reach DIN only when the record ends, so they do not go on to DOUT, and the part reports chip.protocol rule dout_record."
    },
    {
      "what": "light",
      "why": "The reading `color` is the 8-bit red, green and blue the LED latched, not its luminous intensity. The sheet rates each colour's intensity separately, and the model does not weigh them. The drawing lights the lens in the latched colour, at full glow when its brightest channel is 255."
    },
    {
      "what": "supply and current",
      "why": "Section 8 lists VDD from +3.7 V to +5.5 V. The ESP32-S3-DevKitC-1 ties this LED to 3.3 V, which is below that range, and the kind does not check the supply. Section 9 names SK6805MINI-HS at 5 mA and SK6812MINI-HS at 12 mA. Section 10's static IDD typical is 1 mA. The part does not pick one of those currents."
    },
    {
      "what": "bit times",
      "why": "The kind uses the Worldsemi WS2812E-1313 V1.1 windows, a 0 for a high of 220 ns to 380 ns and a 1 for 580 ns to 1 us. Section 12 of this sheet gives T0H as 0.2 / 0.32 / 0.4 us and T1H as 0.62 / 0.64 / 1.0 us, and section 11 gives fDIN typical 800 kHz. The typical highs sit inside those windows. T0H maximum, 0.4 us, does not."
    }
  ]
}

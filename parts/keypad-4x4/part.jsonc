  "not_simulated": [
    {
      "what": "operating force and tactile snap",
      "why": "Adafruit 3844 specifies 160 to 180 g actuation force; a press is a contact change and force is not modelled.",
    },
    {
      "what": "contact bounce by default",
      "why": "Handson Technology 4x4 Matrix Membrane Keypad Data Specs (p1) specifies <= 5 ms contact bounce; `bounce` is unset by default and can be set (for example `\"bounce\": \"5ms\"`) to simulate contact chatter.",
    },
    {
      "what": "contact resistance variation",
      "why": "Every closed key uses the 100 ohm maximum from Adafruit 3844 rather than varying with finger pressure or membrane trace length.",
    },
    {
      "what": "ribbon cable length",
      "why": "Parallax #27899 specifies an 88 mm flexible ribbon cable; the 3D model draws a shorter rigid tail ending in a 1x8 2.54 mm header so it sits cleanly beside a breadboard.",
    },
  ],

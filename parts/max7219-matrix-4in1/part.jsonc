// 4-in-1 chained MAX7219 32 x 8 LED dot matrix module (FC-16 style).
// Seated frame: z = 0 is the 1x5 header plastic's underside, so the board's underside is at
// z = 2.54 mm and its top at z = 4.14 mm. Four 32 x 32 mm 8 x 8 matrices sit edge-to-edge on
// a 138 x 32 mm board: m0 at +48 mm (right, DIN side) chained via DOUT -> DIN through m1
// (+16 mm), m2 (-16 mm) and m3 (-48 mm, left, DOUT side). Matches MD_MAX72XX::FC16_HW and
// MD_Parola scrolling left to right across the four modules.
{
  "format": 7,
  "part": "max7219-matrix-4in1",
  "version": "0.1.0",
  "title": "MAX7219 4-in-1 32 x 8 LED dot matrix module (FC-16)",
  "summary": "Four chained 8 x 8 red LED dot matrices (32 x 8, FC-16) with MAX7219 drivers, 10 kΩ RSET and 5-pin IN/OUT headers. Works with MD_Parola.",
  "tags": ["max7219", "led", "matrix", "dot", "dot-matrix", "8x8", "32x8", "4-in-1", "fc-16", "parola", "1088as", "display", "screen", "spi"],
  "license": "MIT OR Apache-2.0",
  "docs": {
    "Maxim MAX7219/MAX7221 datasheet (19-4452; Rev 4; 7/03)": "https://www.sparkfun.com/datasheets/Components/General/COM-09622-MAX7219-MAX7221.pdf",
    "Betlux BL-M12A881 datasheet (Rev V.2)": "https://cdn-shop.adafruit.com/datasheets/BL-M12A881.PDF",
  },

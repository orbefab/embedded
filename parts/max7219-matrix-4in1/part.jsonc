    "m2": { "type": "max7219-8x8" },
    "m3": { "type": "max7219-8x8" },
    "rset0": { "type": "resistor-0603", "resistance": { "value": 10000, "unit": "ohm", "source": { "datasheet": { "doc": "Maxim MAX7219/MAX7221 datasheet (19-4452; Rev 4; 7/03)", "at": "p. 11, Selecting RSET Resistor and Table 11: common FC-16 module fits 10 kohm per MAX7219", "basis": "nominal" } } } },
    "rset1": { "type": "resistor-0603", "resistance": { "value": 10000, "unit": "ohm", "source": { "datasheet": { "doc": "Maxim MAX7219/MAX7221 datasheet (19-4452; Rev 4; 7/03)", "at": "p. 11, Selecting RSET Resistor and Table 11: common FC-16 module fits 10 kohm per MAX7219", "basis": "nominal" } } } },
    "rset2": { "type": "resistor-0603", "resistance": { "value": 10000, "unit": "ohm", "source": { "datasheet": { "doc": "Maxim MAX7219/MAX7221 datasheet (19-4452; Rev 4; 7/03)", "at": "p. 11, Selecting RSET Resistor and Table 11: common FC-16 module fits 10 kohm per MAX7219", "basis": "nominal" } } } },
    "rset3": { "type": "resistor-0603", "resistance": { "value": 10000, "unit": "ohm", "source": { "datasheet": { "doc": "Maxim MAX7219/MAX7221 datasheet (19-4452; Rev 4; 7/03)", "at": "p. 11, Selecting RSET Resistor and Table 11: common FC-16 module fits 10 kohm per MAX7219", "basis": "nominal" } } } },
    "c_bulk0": { "type": "capacitor-tantalum-3216", "capacitance": { "value": 1e-5, "unit": "F", "source": { "datasheet": { "doc": "Maxim MAX7219/MAX7221 datasheet (19-4452; Rev 4; 7/03)", "at": "p. 11, Supply Bypassing: 10 uF electrolytic between V+ and GND", "basis": "nominal" } } } },
    "c_bulk1": { "type": "capacitor-tantalum-3216", "capacitance": { "value": 1e-5, "unit": "F", "source": { "datasheet": { "doc": "Maxim MAX7219/MAX7221 datasheet (19-4452; Rev 4; 7/03)", "at": "p. 11, Supply Bypassing: 10 uF electrolytic between V+ and GND", "basis": "nominal" } } } },
    "c_bulk2": { "type": "capacitor-tantalum-3216", "capacitance": { "value": 1e-5, "unit": "F", "source": { "datasheet": { "doc": "Maxim MAX7219/MAX7221 datasheet (19-4452; Rev 4; 7/03)", "at": "p. 11, Supply Bypassing: 10 uF electrolytic between V+ and GND", "basis": "nominal" } } } },
    "c_bulk3": { "type": "capacitor-tantalum-3216", "capacitance": { "value": 1e-5, "unit": "F", "source": { "datasheet": { "doc": "Maxim MAX7219/MAX7221 datasheet (19-4452; Rev 4; 7/03)", "at": "p. 11, Supply Bypassing: 10 uF electrolytic between V+ and GND", "basis": "nominal" } } } },

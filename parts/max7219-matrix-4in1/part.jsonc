    "c_dec2": { "type": "capacitor-0603", "capacitance": { "value": 1e-7, "unit": "F", "source": { "datasheet": { "doc": "Maxim MAX7219/MAX7221 datasheet (19-4452; Rev 4; 7/03)", "at": "p. 11, Supply Bypassing: 0.1 uF ceramic between V+ and GND", "basis": "nominal" } } } },
    "c_dec3": { "type": "capacitor-0603", "capacitance": { "value": 1e-7, "unit": "F", "source": { "datasheet": { "doc": "Maxim MAX7219/MAX7221 datasheet (19-4452; Rev 4; 7/03)", "at": "p. 11, Supply Bypassing: 0.1 uF ceramic between V+ and GND", "basis": "nominal" } } } },
  },

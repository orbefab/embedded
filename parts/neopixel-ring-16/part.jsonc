  "not_simulated": [
    {
      "what": "the board's solder pads",
      "why": "Product 1463 brings out 5V (twice), GND (twice), IN and OUT on six through-hole solder pads spaced around the ring. This module groups GND, 5V, DIN and DOUT onto a 1x4 right-angle header on the -X edge so jumper wires connect cleanly beside a breadboard.",
    },
    {
      "what": "the series resistor and decoupling capacitors",
      "why": "The rev C Eagle board places a series resistor on DIN and five 0603 decoupling capacitors across 5V and GND. Those passives are omitted here; a scene puts its own series resistor on DIN.",
    },
    {
      "what": "full-white supply current",
      "why": "Each WS2812B-V5 draws 0.6 mA idle and 12 mA per channel (36.6 mA at rgb(255,255,255), p3). All 16 pixels at full white draw about 586 mA, which exceeds a Nano's 500 mA USB supply and warns unless powered from an external 5 V supply.",
    },
  ],

// TOPLITE A-5161AS, 0.56 inch single digit super red display. Each segment is one LED. Pins 3 and 8 are both com.
{
  "format": 5,
  "part": "display-7seg-cc",
  "version": "0.1.0",
  "title": "0.56 in 7-segment display, common cathode",
  "summary": "One digit, 0.56 inch, common cathode, 10 pins on 2.54 mm. TOPLITE A-5161AS, the 5161AS kind: pins 3 and 8 are the common cathode, and a, b, c, d, e, f, g and dp are the segment anodes. Each segment warns above 30 mA and 80 mW. Drive a segment high through its own resistor. The page lights each segment by its current, and digit reads 0 to 9 when the lit segments are that digit.",
  "tags": ["display", "7-segment", "5161as", "through-hole"],
  "license": "MIT OR Apache-2.0",
  "docs": {
    "TOPLITE A-5161AS, 0.56 inch single digit super red display": "http://www.topliteusa.com/uploadfile/2014/0825/A-5161AS.pdf",
  },
  "real": { "maker": "TOPLITE", "number": "A-5161AS", "datasheet": "TOPLITE A-5161AS, 0.56 inch single digit super red display" },
  "pins": { "e": [1], "d": [2], "com": [3, 8], "c": [4], "dp": [5], "b": [6], "a": [7], "f": [9], "g": [10] },
  "model": {
    "seg_a": {
      "kind": "led",
      "saturation_current": { "value": 3.272e-14, "unit": "A", "source": { "datasheet": { "doc": "TOPLITE A-5161AS, 0.56 inch single digit super red display", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.62 V, 2 mA), (1.80 V, 10 mA), (1.94 V, 20 mA) read off the figure, at kT/q for 298.15 K", "basis": "typical" } } },
      "emission_coefficient": { "value": 2.509, "unit": "1", "source": { "datasheet": { "doc": "TOPLITE A-5161AS, 0.56 inch single digit super red display", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.62 V, 2 mA), (1.80 V, 10 mA), (1.94 V, 20 mA) read off the figure, at kT/q for 298.15 K", "basis": "typical" } } },
      "series_resistance": { "value": 9.532, "unit": "ohm", "source": { "datasheet": { "doc": "TOPLITE A-5161AS, 0.56 inch single digit super red display", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.62 V, 2 mA), (1.80 V, 10 mA), (1.94 V, 20 mA) read off the figure, at kT/q for 298.15 K", "basis": "typical" } } },
      "ratings": {
        "current": { "value": 0.03, "unit": "A", "basis": { "sustained": { "average": "mean", "tau": { "value": 0.001, "unit": "s", "source": { "closed_form": { "note": "The sheet states 120 mA peak at 1/10 duty and no pulse width. On a 1 ms mean, one period of a 1 kHz 1/10 pulse, 120 mA settles at 120 mA times (1 - e^-0.1) / (1 - e^-1), about 18 mA, under the 30 mA continuous rating." } } }, "peak": { "value": 0.12, "unit": "A", "source": { "datasheet": { "doc": "TOPLITE A-5161AS, 0.56 inch single digit super red display", "at": "Maximum Ratings, peak forward current, 120 mA per segment at 1/10 duty cycle, Ta = 25 C", "basis": "absolute_max" } } } } }, "source": { "datasheet": { "doc": "TOPLITE A-5161AS, 0.56 inch single digit super red display", "at": "Maximum Ratings, forward current, 30 mA per segment at Ta = 25 C", "basis": "absolute_max" } } },
        "power": { "value": 0.08, "unit": "W", "basis": { "sustained": { "average": "mean", "tau": { "value": 0.0102, "unit": "s", "source": { "closed_form": { "note": "The sheet gives no pulse rating for power, so this is the 10.2 ms default, five periods of a 490 Hz PWM." } } } } }, "source": { "datasheet": { "doc": "TOPLITE A-5161AS, 0.56 inch single digit super red display", "at": "Maximum Ratings, power consumption, 80 mW per segment at Ta = 25 C", "basis": "absolute_max" } } }

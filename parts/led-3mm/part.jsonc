  "readings": {
    "lit": { "of": "i", "above": { "value": 0.002, "unit": "A", "source": { "datasheet": { "doc": "Kingbright L-934ID, Spec No DSAA4904, Rev V.12A", "at": "The lowest point of each color's forward-voltage fit, 2 mA. Fig. Luminous Intensity vs. Forward Current is a straight line from 0 mA on each datasheet, normalized at 10 mA on the L-934ID, the L-934YD (DSAA9497 Rev V.11B) and the L-934GD (DSAA6381 Rev V.15B), and at 20 mA on the L-934VBC-D (DSAP9934 Rev V.1B) and the L-934QWC-D (DSAE9128 Rev V.3).", "basis": "typical" } } } },
    "dim": { "of": "i", "above": { "value": 0.0001, "unit": "A", "source": { "datasheet": { "doc": "Kingbright L-934ID, Spec No DSAA4904, Rev V.12A", "at": "100 uA. Reverse current is 10 uA max at VR = 5 V on red, yellow, green and white, so the floor is ten times that leakage, and 50 uA max on blue, so the floor is twice that leakage.", "basis": "typical" } } } },
    "brightness": { "of": "i", "full": { "value": 0.01, "unit": "A", "source": { "datasheet": { "doc": "Kingbright L-934GD, Spec No DSAA6381, Rev V.15B", "at": "Selection Guide. Red, yellow and green rate Iv at 10 mA. Blue (L-934VBC-D) and white (L-934QWC-D) rate Iv at 20 mA; the drawing still scales every color by 10 mA.", "basis": "nominal" } } } },
  },
  "view": {
    "glow": [{ "node": "body", "by": "brightness" }],
    "tint": [{ "node": "body", "by": "color" }],
  },
  "not_simulated": [
    { "what": "light", "why": "The engine reports current, not luminous intensity. The drawing scales every color by 10 mA, so the glow is 1 at 10 mA and blooms above that. Blue and white rate luminous intensity at 20 mA, and that difference is not modeled. The colors' intensities differ and are not modeled. Each color's forward curve is fitted from 2 mA to 20 mA through the three points named on its fit. Below 2 mA and above 20 mA the current is that curve extended. A threshold at 1 mA would sit outside the fit. Luminous intensity versus forward current is drawn as a straight line from 0 mA on each datasheet, so the extended current still glows in proportion." },
    { "what": "temperature", "why": "The fits are at 25 C and the engine has no temperature." },
    { "what": "reverse breakdown", "why": "The engine's LED has no breakdown voltage. The datasheets rate 5 V reverse." },
  ],
}

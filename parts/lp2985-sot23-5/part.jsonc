    "line_regulation": { "value": 0.000231, "unit": "1", "source": { "closed_form": { "note": "p5 legacy line regulation 0.007 %/V typical from VO(NOM)+1 V to 16 V, times 3.3 V" } } },
    "output_resistance": { "value": 0.3322147651006711, "unit": "ohm", "source": { "closed_form": { "note": "p5 standard grade widens from ±1.5% at 1 mA to ±3.0% over 1 mA to 150 mA, the rated current. (0.030 - 0.015) * 3.3 V / 0.149 A. The 1 mA to 50 mA window is 0.673469387755102 ohm and is not this field. Page 25 figures 7-3 and 7-5 read about 0.26 ohm and 0.29 ohm." } } },
    "dropout_voltage": { "value": 0.0051677852348993285, "unit": "V", "source": { "closed_form": { "note": "the line through p6 legacy typical dropout, 7 mV at 1 mA and 280 mV at 150 mA" } } },
    "dropout_resistance": { "value": 1.8322147651006713, "unit": "ohm", "source": { "closed_form": { "note": "the line through p6 legacy typical dropout, 7 mV at 1 mA and 280 mV at 150 mA" } } },
    "current_limit": { "value": 0.35, "unit": "A", "source": { "datasheet": { "doc": "TI SLVS522S", "at": "p7, legacy peak output current typical, VOUT at least VO(NOM) - 5%", "basis": "typical" } } },
    "quiescent_current": { "value": 6.5e-05, "unit": "A", "source": { "datasheet": { "doc": "TI SLVS522S", "at": "p6, legacy GND pin current typical at IOUT = 0", "basis": "typical" } } },
    "ground_current_ratio": { "value": 0.005233333333333334, "unit": "1", "source": { "closed_form": { "note": "p6 legacy GND pin current, 65 uA at 0 mA and 850 uA at 150 mA" } } },

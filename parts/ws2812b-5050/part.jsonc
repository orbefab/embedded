        },
      },
    },
    "dout": {
      "output": {
        "high_drop": { "value": 0.0, "unit": "V", "source": { "closed_form": { "note": "The sheet gives no DOUT output voltage. DOUT drives the next pixel's DIN (II = +/-1 uA max on p3), so high sits at VDD." } } },
        "high_resistance": { "value": 100.0, "unit": "ohm", "source": { "closed_form": { "note": "The sheet gives no DOUT drive strength; 100 ohm keeps a shorted DOUT near 50 mA at 5 V without changing logic levels into DIN." } } },
        "low_drop": { "value": 0.0, "unit": "V", "source": { "closed_form": { "note": "The sheet gives no DOUT output voltage; low sits at VSS." } } },
        "low_resistance": { "value": 100.0, "unit": "ohm", "source": { "closed_form": { "note": "The sheet gives no DOUT drive strength; 100 ohm keeps a shorted DOUT near 50 mA at 5 V." } } },

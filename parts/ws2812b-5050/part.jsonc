  "not_simulated": [
    {
      "what": "data output",
      "why": "DOUT follows DIN 300 ns later once this LED holds its 24 bits, and stays low otherwise. Page 3 gives 300 ns as a maximum and no drive strength.",
    },
    {
      "what": "light",
      "why": "The reading `color` is the 8-bit red, green and blue latched by the pixel, not luminous intensity (p3 lists 310 mcd Red, 780 mcd Green and 215 mcd Blue at 12 mA).",
    },
    {
      "what": "supply voltage",
      "why": "Page 2 rates VDD from +3.7 V to +5.3 V and gives no power-on reset or falling threshold. The pixel powers up once VDD rises to 3.7 V, and clears to off, ignores DIN and releases DOUT once VDD falls below 3.33 V (90% of 3.7 V, an estimate), leaving only the faded quiescent draw (0 A at 0 V).",
    },
    {
      "what": "input thresholds at non-5 V supply",
      "why": "Page 3 lists fixed thresholds VIH >= 2.7 V and VIL <= 0.7 V at VDD = 5 V. The engine scales input thresholds proportionally to VDD (0.54 VDD and 0.14 VDD), matching p3 exactly at 5 V.",
    },
    {
      "what": "upper DIN margin",
      "why": "Page 3 allows DIN up to VDD + 0.7 V and down to -0.3 V. Because the engine's rail_margin is symmetric, DIN warns past VDD + 0.3 V as well as below -0.3 V.",
    },
  ],
}

// Bosch BMP280, BST-BMP280-DS001-26. The LGA-8 pin order is the sheet's Table 29.
// The engine kind reads the scene's temperature and pressure and answers on I2C.
{
  "format": 1,
  "part": "bmp280",
  "version": "0.1.0",
  "title": "BMP280 temperature and pressure sensor",
  "summary": "Bosch BMP280 in an 8-pad LGA, 2.0 x 2.5 mm. It reads the scene's temperature and pressure over I2C. SDO low is address 0x76 and SDO high is 0x77. CSB must stay high; low is SPI, which is not modelled. The chip id is 0x58. A compensated read matches the world within 1 °C and 1 hPa.",
  "tags": ["bmp280", "temperature", "pressure", "sensor", "i2c", "lga"],
  "license": "MIT OR Apache-2.0",
  "docs": {
    "BST-BMP280-DS001-26": "https://www.bosch-sensortec.com/media/boschsensortec/downloads/datasheets/bst-bmp280-ds001.pdf"
  },
  "real": {
    "generic": false,
    "maker": "Bosch Sensortec",
    "number": "BMP280",
    "datasheet": "BST-BMP280-DS001-26"
  },
  "pins": {
    "GND": [1, 7],
    "CSB": [2],
    "SDI": [3],
    "SCK": [4],
    "SDO": [5],
    "VDDIO": [6],
    "VDD": [8]
  },
  "model": {
    "kind": "bmp280",
    "pins": {
      "VDD": "VDD",
      "VDDIO": "VDDIO",

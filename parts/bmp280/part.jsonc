      "CSB": "CSB",
      "SDI": "SDI",
      "SCK": "SCK",
      "SDO": "SDO"
    },
    "low_resistance": {
      "value": 108.0,
      "unit": "ohm",
      "source": {
        "closed_form": {
          "note": "Table 26, Vol_SDI maximum 0.2 * VDDIO at 3 mA with VDDIO 1.62 V. 0.324 V / 3 mA. The sheet gives no typical, so the open drain is that maximum."
        }
      }
    },
    "input_threshold": {
      "low": {
        "value": 0.2,
        "unit": "1",
        "source": {
          "datasheet": {
            "doc": "BST-BMP280-DS001-26",
            "at": "Table 26, Vil_si maximum 0.2 * VDDIO, VDDIO from 1.2 V to 3.6 V",
            "basis": "max"
          }
        }
      },
      "high": {
        "value": 0.8,
        "unit": "1",
        "source": {
          "datasheet": {
            "doc": "BST-BMP280-DS001-26",
            "at": "Table 26, Vih_si minimum 0.8 * VDDIO, VDDIO from 1.2 V to 3.6 V",
            "basis": "min"
          }
        }
      }
    }
  },
  "not_simulated": [
    {
      "what": "SPI",
      "why": "CSB low selects SPI (section 5.3). The part does not answer on I2C then, and the first time is chip.protocol rule spi. No SPI transfer is modelled. spi3w_en set to 1 is rule spi3w."
    },
    {
      "what": "NVM copy",
      "why": "im_update is 1 while the trimming words are copied at power-on and before each conversion (section 4.3.3). That copy takes no time here, so the bit stays 0 and the words are readable from t = 0."
    },
    {
      "what": "supply current",
      "why": "Table 12 gives the current at 1 Hz. The part draws none. VDD and VDDIO need another path to a supply."
    },
    {
      "what": "accuracy",
      "why": "A compensated read is the world's value, clamped to -40 to 85 °C and 300 to 1100 hPa, then quantized by the 20-bit sample and the integer formulas. The sheet allows ±1.0 °C from 0 to 65 °C and ±1 hPa absolute."
    }
  ]
}

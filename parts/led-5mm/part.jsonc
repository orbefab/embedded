// The red fit, the ratings and their sources are the engine's WP7113ID values, from
// engine/examples/led-5v/netlist.json.
{
  "format": 1,
  "part": "led-5mm",
  "version": "0.1.0",
  "title": "5 mm LED",
  "summary": "Round 5 mm through-hole LED, two leads on 2.54 mm. The longer lead is the anode. Pick its colour.",
  "tags": ["led", "light", "indicator", "through-hole"],
  "license": "MIT OR Apache-2.0",
  "docs": { "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A": "https://www.kingbrightusa.com/images/catalog/SPEC/WP7113ID.pdf" },
  "real": { "maker": "Kingbright", "number": "WP7113", "datasheet": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A" },
  "pins": { "anode": [1], "cathode": [2] },
  "params": {
    "color": {
      "required": true,
      "choices": {
        "red": {
          "real": { "number": "WP7113ID" },
          "tint": "#d8342a",
          "sets": {
            "/saturation_current": { "value": 6.711e-10, "unit": "A", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K", "basis": "typical" } } },
            "/emission_coefficient": { "value": 4.427, "unit": "1", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K", "basis": "typical" } } },
            "/series_resistance": { "value": 2.115, "unit": "ohm", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K", "basis": "typical" } } },
          },
        },
      },
    },
  },
  "model": {
    "kind": "led",
    "ratings": {
      "current": { "value": 0.03, "unit": "A", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Absolute Maximum Ratings at Ta = 25 C, DC forward current", "basis": "absolute_max" } } },
      "power": { "value": 0.075, "unit": "W", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Absolute Maximum Ratings at Ta = 25 C, power dissipation", "basis": "absolute_max" } } },
    },
  },
  "readings": {
    "on": { "of": "i", "above": { "value": 0.001, "unit": "A", "source": { "closed_form": { "note": "One tenth of the 10 mA rating current." } } } },
    "brightness": { "of": "i", "full": { "value": 0.01, "unit": "A", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Electrical / Optical Characteristics, Iv rated at IF = 10 mA", "basis": "nominal" } } } },
  },
  "view": {
    "glow": [{ "node": "body", "by": "brightness" }],
    "tint": [{ "node": "body", "by": "color" }],
  },
  "not_simulated": [
    { "what": "light", "why": "The engine reports current. Brightness is the current over 10 mA, clipped to 1." },
    { "what": "temperature", "why": "The fit is at 25 C and the engine has no temperature." },
    { "what": "reverse breakdown", "why": "The engine's LED has no breakdown voltage." },
  ],
}

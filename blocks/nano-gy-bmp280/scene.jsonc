// A Nano reads a GY-BMP280-3.3. The module has no regulator: its VCC is the BMP280's supply,
// 1.71 V to 3.6 V, so it runs from the Nano's 3V3 pin. Its 10 kΩ pull-ups hold SDA and SCL at
// that 3.3 V. A BSS138 level shifter joins them to the Nano's 5 V I2C: HV is 5V, LV is 3V3,
// A4 (SDA) is HV1 and A5 (SCL) is HV2. The module pulls SDO to ground, so the address is 0x76.
{
  "format": 1,
  "parts": {
    "nano": { "type": "nano-board", "firmware": "build/bmp280.ino.hex" },
    "shifter": { "type": "bss138-level-shifter" },
    "mod": { "type": "gy-bmp280" },
  },
  "layout": {
    "nano": { "at": [0, 0, 0] },
    "shifter": { "at": [55, 0, 0] },
    "mod": { "at": [80, 0, 0] },
  },
  "nets": { "GND": "nano.GND" },
  "wires": [
    ["nano.GND", "shifter.GND"],
    ["nano.GND", "mod.GND"],
    ["nano.5V", "shifter.HV"],
    ["nano.3V3", "shifter.LV"],
    ["nano.3V3", "mod.VCC"],
    ["nano.A4", "shifter.HV1"],
    ["nano.A5", "shifter.HV2"],
    ["shifter.LV1", "mod.SDA"],
    ["shifter.LV2", "mod.SCL"],
  ],
}

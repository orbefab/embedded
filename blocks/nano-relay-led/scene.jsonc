// A Nano toggles a 5 V relay module once a second. COM and NO switch an LED from the 5 V rail.
// The Nano straddles the center channel over columns 1 to 15. The module's header sits on the
// f to j side, and the LED sits on the a to e side.
{
  "format": 1,
  "parts": {
    "bb": { "type": "breadboard-400" },
    "nano": { "type": "nano-board", "firmware": "build/relay.ino.hex" },
    "relay": { "type": "relay-module-1ch" },
    "r1": { "type": "resistor-axial", "resistance": "220" },
    "led1": { "type": "led-5mm" }
  },
  "layout": {
    "bb": { "at": [0, 0, 0] },
    "nano": { "on": { "D13": "bb.d1" } },
    "relay": { "on": { "IN": "bb.f20" } },
    "r1": { "on": { "a": "bb.d25" } },
    "led1": { "on": { "anode": "bb.c29" } }
  },
  "nets": { "GND": "nano.GND" },
  "wires": [
    ["nano.D2", "relay.IN"],
    ["nano.5V", "relay.VCC"],
    ["nano.GND", "relay.GND"],
    ["nano.5V", "relay.COM"],
    ["relay.NO", "r1.a"],
    ["r1.b", "led1.anode"],
    ["led1.cathode", "nano.GND"]
  ]
}

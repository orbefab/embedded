// A Nano scans a 4x4 membrane keypad with the stock Arduino Keypad library.
// The Nano straddles columns 1 to 15 (D11 is j2, D10 is j3, D9 is j4, D8 is j5,
// D5 is j8, D4 is j9, D3 is j10, D2 is j11). Rows use PORTB (D11..D8) and columns
// use PORTD (D5..D2) so reading PINB never samples the hi-Z column pins.
// The keypad sits directly above the Nano's digital edge with its 8-pin header facing
// the breadboard so all eight jumpers run straight and parallel with no crossings.
{
  "format": 1,
  "parts": {
    "bb": { "type": "breadboard-400" },
    "nano": { "type": "nano-board", "firmware": "build/keypad.ino.hex" },
    "pad": { "type": "keypad-4x4" },
  },
  "layout": {
    "bb": { "at": [0, 0, 0] },
    "nano": { "on": { "D13": "bb.d1" } },
    "pad": { "at": [-23, 98, 0] },
  },
  "nets": { "GND": "nano.GND" },
  "wires": [
    ["bb.j2", "pad.R1", { "color": "#d12b2b" }], // D11 -> R1
    ["bb.j3", "pad.R2", { "color": "#e07b24" }], // D10 -> R2
    ["bb.j4", "pad.R3", { "color": "#eab308" }], // D9  -> R3
    ["bb.j5", "pad.R4", { "color": "#2e8b57" }], // D8  -> R4
    ["bb.j8", "pad.C1", { "color": "#2563eb" }], // D5  -> C1
    ["bb.j9", "pad.C2", { "color": "#7c3aed" }], // D4  -> C2
    ["bb.j10", "pad.C3", { "color": "#6b7280" }], // D3  -> C3
    ["bb.j11", "pad.C4", { "color": "#f4f4f4" }], // D2  -> C4
  ],
}

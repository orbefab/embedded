// A button on D2 lights an LED on D13 of an Uno, and the board's own L LED with it.
// The Uno sits beside a half-size breadboard, and jumpers run from its headers to the holes.
{
  "format": 1,
  "parts": {
    "uno": { "type": "uno-board", "firmware": "build/button.ino.hex" },
    "bb": { "type": "breadboard-400" },
    "btn1": { "type": "tactile-switch-6mm" },
    "r2": { "type": "resistor-axial", "resistance": "10k" }, // pull-down, so D2 reads low while open
    "r1": { "type": "resistor-axial", "resistance": "220" },
    "led1": { "type": "led-5mm" },
  },
  "layout": {
    "uno": { "at": [-90, 0, 0] },
    "bb": { "at": [0, 0, 0] },
    "btn1": { "on": { "a": "bb.f16" }, "rotate": [0, 0, 90] }, // across the channel: a in column 16, b in 14
    "r2": { "on": { "a": "bb.b16" }, "rotate": [0, 0, -90] }, // b in X16, the - rail
    "r1": { "on": { "a": "bb.d22" } }, // b in column 26
    "led1": { "on": { "anode": "bb.c26" } }, // cathode in column 27
  },
  "nets": { "GND": "uno.GND" },
  "wires": [
    ["uno.5V", "bb.W3", { "color": "#d12b2b" }],
    ["uno.GND", "bb.X3", { "color": "#161616" }],
    ["bb.a14", "bb.W14", { "color": "#d12b2b" }], // btn1.b to 5V
    ["uno.D2", "bb.j16"], // D2 to btn1.a
    ["uno.D13", "bb.c22"], // D13 to r1.a
    ["bb.a27", "bb.X27", { "color": "#161616" }], // led1.cathode to GND
  ],
}

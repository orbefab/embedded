# The display holds each digit for 200 ms, starting at 0.
open
# The sketch starts 66 ms after power-on, when the start from reset the fuses set is over.
step 116ms
expect @disp.digit 0
step 200ms
expect @disp.digit 1
step 200ms
expect @disp.digit 2
step 200ms
expect @disp.digit 3
step 200ms
expect @disp.digit 4
step 200ms
expect @disp.digit 5
step 200ms
expect @disp.digit 6
step 200ms
expect @disp.digit 7
step 200ms
expect @disp.digit 8
step 200ms
expect @disp.digit 9
step 20ms
expect no diagnostics

// A Nano drives a blue 16x2 character LCD with an FC-113 style PCF8574 I2C backpack at 5 V.
// The Nano straddles the centre channel over columns 1 to 15. On the a to e side A4 (SDA) is
// column 8, A5 (SCL) column 9, 5V column 12 and GND column 14. The LCD module's right-angle
// 4-pin header points sideways parallel to its board, so it lies beside the breadboard and
// connects with four jumper wires.
{
  "format": 1,
  "parts": {
    "bb": { "type": "breadboard-400" },
    "nano": { "type": "nano-board", "firmware": "build/hello.ino.hex" },
    "lcd": { "type": "lcd1602-i2c" },
  },
  "layout": {
    "bb": { "at": [0, 0, 0] },
    "nano": { "on": { "D13": "bb.d1" } },
    "lcd": { "at": [108, 0, 0] },
  },
  "nets": { "GND": "nano.GND" },
  "wires": [
    ["bb.a14", "lcd.GND", { "color": "#161616" }], // GND
    ["bb.a12", "lcd.VCC", { "color": "#d12b2b" }], // 5V to VCC
    ["bb.a8", "lcd.SDA"], // A4 to SDA
    ["bb.a9", "lcd.SCL"], // A5 to SCL
  ],
}

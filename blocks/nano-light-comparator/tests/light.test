# At 300 lx the LDR node is 2.651 V and the threshold is 1.622 V, so the LED is off.
open
step 50ms
expect @led1 off
expect @nano.D2 low
expect @nano.D2 < 0.2V
expect @u1.IN1_N > 2.649V
expect @u1.IN1_N < 2.653V
expect @u1.IN1_P > 1.620V
expect @u1.IN1_P < 1.624V
expect @u1.OUT1 < 0.008V
expect serial contains "light 1"
# 80 lx is between the two thresholds, so the output stays low for this whole step.
set light 80
step 200ms
expect @led1 off
expect @nano.D2 < 0.2V
expect @u1.IN1_N > 1.688V
expect @u1.IN1_N < 1.692V
# 10 lx puts the node at 0.640 V, under both thresholds, so the LED comes on.
set light 10
step --until @led1 on --timeout 100ms
step 50ms
expect @led1 on
expect @nano.D2 high
expect @nano.D2 > 3.3V
expect @u1.OUT1 > 3.55V
expect @u1.OUT1 < 3.57V
expect @u1.IN1_N > 0.637V
expect @u1.IN1_N < 0.642V
expect @u1.IN1_P > 1.784V
expect @u1.IN1_P < 1.789V
expect serial contains "dark 2"
# The same 80 lx, reached from the dark, keeps the LED on.
set light 80
step 200ms
expect @led1 on
expect @nano.D2 > 3.3V
expect @u1.IN1_P > 1.784V
expect @u1.IN1_P < 1.789V
set light 300
step --until @led1 off --timeout 100ms
step 50ms
expect @led1 off
expect @nano.D2 low
expect @nano.D2 < 0.2V
expect serial contains "light 3"
expect no diagnostics

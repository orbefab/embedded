# strip.rainbow(firstHue) cycles a rainbow along the stick, shifting one pixel (hue +8192)
# every 800 ms.
open
step 20ms
expect @stick.px1 rgb(255,0,0)
expect @stick.px2 rgb(255,120,0)
expect @stick.px3 rgb(42,255,0)
expect @stick.px4 rgb(0,255,7)
expect @stick.px5 rgb(0,255,255)
expect @stick.px6 rgb(0,7,255)
expect @stick.px7 rgb(42,0,255)
expect @stick.px8 rgb(255,0,120)
step 800ms
expect @stick.px1 rgb(255,120,0)
expect @stick.px2 rgb(42,255,0)
expect @stick.px8 rgb(255,0,0)
step 800ms
expect @stick.px1 rgb(42,255,0)
expect @stick.px7 rgb(255,0,0)
step 1600ms
expect @stick.px1 rgb(0,255,255)
expect @stick.px5 rgb(255,0,0)
expect no diagnostics

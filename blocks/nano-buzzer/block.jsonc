// A Block: a small circuit that works. `orbe add nano-buzzer` installs it into a project.
{
  "format": 1,
  "block": "nano-buzzer",
  "version": "0.1.2",
  "title": "Buzzer on a Nano",
  "summary": "A passive 12 mm buzzer on D8 of an Arduino Nano plays 440 Hz, rests, plays 880 Hz and rests. A 2N2222 switches the coil from 5 V through 10 ohm, so the drive sits inside the coil's 3 V to 5 V window.",

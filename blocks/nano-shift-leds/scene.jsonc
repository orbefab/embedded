// A Nano drives eight LEDs through one 74HC595. The Nano straddles the centre
// channel over columns 1 to 15. The 595 straddles it from column 18: QB in e18,
// VCC across in f18. Each LED has a 220 ohm resistor past the chip.
{
  "format": 1,
  "parts": {
    "bb": { "type": "breadboard-830" },
    "nano": { "type": "nano-board", "firmware": "build/shift.ino.hex" },
    "u1": { "type": "hc595-dip16" },
    "r1": { "type": "resistor-axial", "resistance": "220" },
    "r2": { "type": "resistor-axial", "resistance": "220" },
    "r3": { "type": "resistor-axial", "resistance": "220" },
    "r4": { "type": "resistor-axial", "resistance": "220" },
    "r5": { "type": "resistor-axial", "resistance": "220" },
    "r6": { "type": "resistor-axial", "resistance": "220" },
    "r7": { "type": "resistor-axial", "resistance": "220" },
    "r8": { "type": "resistor-axial", "resistance": "220" },
    "led1": { "type": "led-5mm" },
    "led2": { "type": "led-5mm" },
    "led3": { "type": "led-5mm" },
    "led4": { "type": "led-5mm" },
    "led5": { "type": "led-5mm" },
    "led6": { "type": "led-5mm" },
    "led7": { "type": "led-5mm" },
    "led8": { "type": "led-5mm" },
  },
  "layout": {
    "bb": { "at": [0, 0, 0] },
    "nano": { "on": { "D13": "bb.d1" } },
    "u1": { "on": { "QB": "bb.e18" } },
    "r1": { "on": { "a": "bb.a32" } },
    "led1": { "on": { "anode": "bb.b36" } },
    "r2": { "on": { "a": "bb.f32" } },
    "led2": { "on": { "anode": "bb.g36" } },
    "r3": { "on": { "a": "bb.a38" } },
    "led3": { "on": { "anode": "bb.b42" } },
    "r4": { "on": { "a": "bb.f38" } },
    "led4": { "on": { "anode": "bb.g42" } },
    "r5": { "on": { "a": "bb.a44" } },
    "led5": { "on": { "anode": "bb.b48" } },
    "r6": { "on": { "a": "bb.f44" } },
    "led6": { "on": { "anode": "bb.g48" } },
    "r7": { "on": { "a": "bb.a50" } },
    "led7": { "on": { "anode": "bb.b54" } },
    "r8": { "on": { "a": "bb.f50" } },
    "led8": { "on": { "anode": "bb.g54" } },
  },
  "nets": { "GND": "nano.GND" },
  "wires": [
    ["bb.a12", "bb.W11", { "color": "#d12b2b" }],
    ["bb.a14", "bb.X15", { "color": "#161616" }],
    ["bb.X13", "bb.Z13", { "color": "#161616" }],
    ["bb.i18", "bb.W19", { "color": "#d12b2b" }],
    ["bb.a25", "bb.X25", { "color": "#161616" }],
    ["bb.i24", "bb.W23", { "color": "#d12b2b" }],
    ["bb.i21", "bb.X21", { "color": "#161616" }],
    ["bb.i2", "bb.i20"],
    ["bb.i1", "bb.i23"],
    ["bb.i5", "bb.i22"],
    ["bb.j19", "bb.c32"],
    ["bb.a18", "bb.h32"],
    ["bb.a19", "bb.c38"],
    ["bb.a20", "bb.h38"],
    ["bb.a21", "bb.c44"],
    ["bb.a22", "bb.h44"],
    ["bb.a23", "bb.c50"],
    ["bb.a24", "bb.h50"],
    ["bb.a37", "bb.X37", { "color": "#161616" }],
    ["bb.f37", "bb.Z37", { "color": "#161616" }],
    ["bb.a43", "bb.X43", { "color": "#161616" }],
    ["bb.f43", "bb.Z43", { "color": "#161616" }],
    ["bb.a49", "bb.X49", { "color": "#161616" }],
    ["bb.f49", "bb.Z49", { "color": "#161616" }],
    ["bb.a55", "bb.X55", { "color": "#161616" }],
    ["bb.f55", "bb.Z55", { "color": "#161616" }],
  ],
}

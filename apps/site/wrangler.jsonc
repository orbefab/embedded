// The Worker orbefab-embedded serves orbefab.com/orbe, and redirects orbefab.com/embedded
// to the same path under /orbe. The name stays orbefab-embedded: a new name would be a second
// Worker, and this one would keep the routes. redirect.js answers /embedded. Static assets from
// dist/client, which scripts/site.sh builds, are mounted at /orbe. A request under /orbe is an
// asset, so the Worker does not see it. The build bundles redirect.js and writes
// dist/orbefab_embedded/wrangler.json from this file. Its assets are dist/client.
// Registry paths run the Worker first, so a 200 for a hashed file can keep for a year
// and a path that contains @ is read as the percent-encoded asset.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbefab-embedded",
  "main": "redirect.js",
  "compatibility_date": "2026-11-01",
  // Routes, not a Custom Domain: the website's Worker holds orbefab.com, and a route runs before
  // it for the paths it matches. `orbefab.com/orbe*` would also match /orbefoo, and the same for
  // /embedded. The zone is named by its ID, the zone orbefab.com, so the deploy token needs no
  // Zone Read to look it up.
  "routes": [
    { "pattern": "orbefab.com/orbe", "zone_id": "82bb63ff17adeced8bd3f19a7409b505" },
    { "pattern": "orbefab.com/orbe/*", "zone_id": "82bb63ff17adeced8bd3f19a7409b505" },
    { "pattern": "orbefab.com/embedded", "zone_id": "82bb63ff17adeced8bd3f19a7409b505" },
    { "pattern": "orbefab.com/embedded/*", "zone_id": "82bb63ff17adeced8bd3f19a7409b505" },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "base_path": "/orbe",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/orbe/r/*"],
  },
}

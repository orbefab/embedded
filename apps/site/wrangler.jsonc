// The Worker that serves orbefab.com/embedded and every path under it. It runs no code: it serves
// dist/, which scripts/site.sh builds, as static assets. docs/site.md says how to deploy it.
{
  "name": "orbefab-embedded",
  "compatibility_date": "2026-11-01",
  // A route, not a Custom Domain: the website's Worker holds orbefab.com, and a route runs
  // before it for these paths.
  "routes": [{ "pattern": "orbefab.com/embedded*", "zone_name": "orbefab.com" }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
